# ==============================================================================
# Slide & Solve - Google Ads Admin Panel Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=slide_solve_ads
# Optional full connection URL (takes precedence if provided):
# DATABASE_URL=postgresql://user:password@localhost:5432/slide_solve_ads

# Express Session Security Secret
SESSION_SECRET=change_me_to_a_long_cryptographically_secure_random_string_32chars

# Seed Script Credentials (Used by: npm run seed:admin)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!

# Legacy Static Tokens (Preserved for existing app endpoints)
STATIC_AUTH_TOKEN=your_secure_random_token_123456
ANDROID_API_KEY=your_android_api_key_here
IOS_API_KEY=your_ios_api_key_here
